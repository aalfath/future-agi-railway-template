# Edge proxy: one public port for the UI, the API, websockets, OTLP/HTTP
# traces, the LLM gateway (/gateway/) and stored files (bucket paths).
worker_processes 1;
pid /run/nginx-edge.pid;
error_log stderr warn;
events { worker_connections 1024; }
http {
    access_log off;
    server_tokens off;
    client_body_temp_path /var/lib/nginx-edge/body;
    proxy_temp_path /var/lib/nginx-edge/proxy;
    fastcgi_temp_path /var/lib/nginx-edge/fastcgi;
    uwsgi_temp_path /var/lib/nginx-edge/uwsgi;
    scgi_temp_path /var/lib/nginx-edge/scgi;
    client_max_body_size 1G;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_buffering off;
    proxy_request_buffering off;

    map $http_upgrade $connection_upgrade { default upgrade; '' ''; }

    server {
        listen __PORT__;
        listen [::]:__PORT__;
        server_name _;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # OTLP/HTTP traces from SDKs (FI_BASE_URL) go to fi-collector.
        location ~ ^/(tracer/)?v1/traces$ {
            proxy_pass http://127.0.0.1:4318;
        }

        # The LLM gateway (OpenAI-compatible), under /gateway/.
        location /gateway/ {
            proxy_pass http://127.0.0.1:8080/;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        # Stored files (MINIO_URL/<bucket>/<key>) from the bundled object storage.
        location ~ ^/(fi-content|fi-content-dev|fi-customer-data-dev|futureagi)/ {
            proxy_pass http://127.0.0.1:9005;
        }

        # Sign-up stays open until the first account exists (signup-guard.sh).
        location ~ ^/+accounts/+signup {
            default_type application/json;
            if (-f /run/railway-edge/signup-closed) {
                return 403 '{"status":false,"result":"Sign-up is closed on this instance. Ask an owner for an invite."}';
            }
            proxy_pass http://127.0.0.1:8000;
        }

        # Single-page app routes and its static files.
        location = / { proxy_pass http://127.0.0.1:3000; }
        location = /mcp/authorize { proxy_pass http://127.0.0.1:3000; }
        location ~ ^/(dashboard|auth|setup|shared|sos|404)(/|$) { proxy_pass http://127.0.0.1:3000; }
        location ~ ^/(assets|favicon|fonts|icons|logo)/ { proxy_pass http://127.0.0.1:3000; }
        location ~ ^/(index\.html|config\.js|starting-status\.json|manifest\.json|robots\.txt|service-worker\.js|mockServiceWorker\.js|_redirects)$ { proxy_pass http://127.0.0.1:3000; }

        # Everything else is the API (REST, /docs, /admin, websockets on /ws/).
        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }
}
